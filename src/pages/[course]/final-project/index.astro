---
// The Final Project brief: /250/final-project/ and /340/final-project/ (Oct 21). One per course.
// Source: dight-refactor/course-site-content/release/<course>-release.md (tier: release,
// released: 2026-11-16), copied by npm run sync. It follows the same publish rule as every
// brief: no page until it's `ready: true` and its `released` date has come.
import PageView from '../../../components/PageView.astro';
import { releasePage } from '../../../lib/published';
import { courseOrder, type Course } from '../../../lib/courses';

export async function getStaticPaths() {
  const found = await Promise.all(courseOrder.map(async (course) => ({ course, page: await releasePage(course) })));
  return found.flatMap(({ course, page }) => (page ? [{ params: { course }, props: { page } }] : []));
}

const { page } = Astro.props;
const course = Astro.params.course as Course;
---

<PageView {page} {course} />
