---
// Course home: /250/ and /340/ (site v2, Oct 17). Nothing here needs a weekly edit:
// the topic list has no dates and no "current" marker, and the setup guide stays all term.
// Order: setup guide, your setup, the term (topics, Prototypes, Release), skills, reference.
// Oct 19: a topic links to its unit page (via `unit:` in topics-NNN.yml) and that unit's
// Spark, and each Prototype row links to its brief, once those pages are published.
// Oct 21: a "Find your way" row links the Schedule, the three indexes, and the Release
// brief; Prototype and Release dates come from the course registry (src/data/courses.json);
// reflections are gone (dropped Oct 21).
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { courses, courseOrder, fmtDay, type Course } from '../../lib/courses';
import { skillInfo, skillOrder, skillHref } from '../../lib/skills';
import { findPage, pageHref, parseId, prototypePage, releasePage, sessionPair } from '../../lib/published';

export function getStaticPaths() {
  return courseOrder.map((course) => ({ params: { course } }));
}

const course = Astro.params.course as Course;
const c = courses[course];
const topics = (await getEntry('topics', course))?.data ?? [];
const spark0 = await getEntry('pages', `spark-0-${course}`);

// Links only to pages this build shows, so production never links a draft.
const topicLinks = await Promise.all(
  topics.map(async (t) => {
    const unit = t.unit ? await findPage(course, 'unit', t.unit) : undefined;
    const spark = unit?.data.session ? (await sessionPair(course, unit.data.session)).spark : undefined;
    const brief = t.prototype ? await prototypePage(course, t.prototype) : undefined;
    return {
      unit: unit && pageHref(unit),
      spark: spark && { href: pageHref(spark), label: parseId(spark.id)!.slug.toUpperCase() },
      prototype: brief && pageHref(brief),
    };
  }),
);
const prototypeHrefs = Object.fromEntries(
  await Promise.all(
    c.prototypes.map(async ({ id }) => {
      const brief = await prototypePage(course, id);
      return [id, brief && pageHref(brief)] as const;
    }),
  ),
);
const release = await releasePage(course);
const r = c.release;
// The row under the title. The Release brief links only once it's published.
const findYourWay = [
  { href: `/${course}/schedule/`, label: 'Schedule' },
  { href: `/${course}/units/`, label: 'Units' },
  { href: `/${course}/sparks/`, label: 'Sparks' },
  { href: `/${course}/prototypes/`, label: 'Prototypes' },
  ...(release ? [{ href: pageHref(release), label: 'Release brief' }] : []),
];
---

<Base title={c.name} description={`${c.name}: ${c.topic}. Setup, topics this term, and skills.`} course={course}>
  <h1>{c.name}</h1>
  <p class="lede"><Badge kind={course} /> {c.topic}</p>

  <nav class="find" aria-labelledby="find">
    <h2 id="find">Find your way</h2>
    <ul role="list">
      {findYourWay.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      {!release && <li class="soon">Release brief: out {fmtDay(r.released)}</li>}
    </ul>
  </nav>

  <section class="start" aria-labelledby="start">
    <h2 id="start"><Badge kind="spark" /> Setup guide (Spark 0)</h2>
    <p>{spark0?.data.description}</p>
    <p class="go"><a href={`/${course}/spark-0/`}>Open the Spark 0 guide</a></p>
  </section>

  <section aria-labelledby="setup">
    <h2 id="setup">Your setup</h2>
    {
      course === '250' ? (
        <dl class="facts">
          <div>
            <dt>Agent</dt>
            <dd>GitHub Copilot Chat in VS Code, on the free tier, with the GitHub account you already push with.</dd>
          </div>
          <div>
            <dt>Scope</dt>
            <dd>HTML and CSS only, with no frameworks. JavaScript appears once, in the bridge to 340 at the end of term.</dd>
          </div>
          <div>
            <dt>Repo</dt>
            <dd>Your <code>username.github.io</code> hub, restructured in Spark 0.</dd>
          </div>
          <div>
            <dt>Running example</dt>
            <dd>The Saturday Morning Archive.</dd>
          </div>
          <div>
            <dt>Git</dt>
            <dd>You commit and push in GitHub Desktop. The agent tells you what to check and suggests a commit summary.</dd>
          </div>
        </dl>
      ) : (
        <>
          <dl class="facts">
            <div>
              <dt>Agent</dt>
              <dd>
                Claude Code, in the Claude desktop app’s Code tab, on your own Claude Pro account. Copilot Chat in VS
                Code is the free fallback, and it reads the same rules.
              </dd>
            </div>
            <div>
              <dt>Scope</dt>
              <dd>Vanilla JavaScript, Svelte 5, and Astro. TypeScript only where Svelte or Astro uses it, explained.</dd>
            </div>
            <div>
              <dt>Repo</dt>
              <dd>
                <code>dight340-exercises</code>, renamed to <code>dight340</code> in Spark 0, which changes its address.
                Plain folders until the Astro unit, when your Release becomes an Astro site in <code>release/</code>.
              </dd>
            </div>
            <div>
              <dt>Running example</dt>
              <dd>Your Pokémon party, with PokéAPI.</dd>
            </div>
            <div>
              <dt>Class</dt>
              <dd>
                A seminar: the unit page frames the concept for about 10 minutes, then you drive the agent through the
                live build while I coach. Expect an “explain this line” question every class.
              </dd>
            </div>
            <div>
              <dt>Git</dt>
              <dd>You commit and push in GitHub Desktop. The agent tells you what to check and suggests a commit summary.</dd>
            </div>
          </dl>

          <h3>Working with Claude Code</h3>
          <ul>
            <li>
              After Spark 0, the repo sets Claude to its <strong>Learning</strong> style: it leaves some decisions in the
              code for you to make. From the Astro unit it switches to <strong>Explanatory</strong>.
            </li>
            <li>
              Your Pro usage limit is shared with chat, so build good habits from day one: plan before generating, ask
              for small, scoped changes, and <code>/clear</code> between tasks. If you hit the limit, carry on in
              Copilot Chat.
            </li>
          </ul>
        </>
      )
    }
  </section>

  <section aria-labelledby="term">
    <h2 id="term">The term</h2>

    <h3>Topics this term</h3>
    <p class="note">In teaching order. For dates, see the <a href={`/${course}/schedule/`}>schedule</a>.</p>
    <ol class="topics">
      {
        topics.map((t, i) => {
          const links = topicLinks[i];
          return (
            <li>
              {links.unit ? (
                <a class="topic-name" href={links.unit}>
                  {t.name}
                </a>
              ) : (
                <span class="topic-name">{t.name}</span>
              )}
              {t.tier && <Badge kind={t.tier} />}
              {links.spark && (
                <a class="topic-link" href={links.spark.href}>
                  Spark {links.spark.label}
                </a>
              )}
              {t.prototype && (
                <span class="topic-proto">
                  Feeds {links.prototype ? <a href={links.prototype}>{t.prototype}</a> : t.prototype}
                </span>
              )}
              <span class="topic-summary">{t.summary}</span>
            </li>
          );
        })
      }
    </ol>

    <h3>Prototypes</h3>
    <p class="note">Dates may shift as the term goes on. Learning Suite always has the current ones.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label={`${c.name} Prototypes`}>
      <table>
        <thead>
          <tr><th scope="col">Prototype</th><th scope="col">Topic</th><th scope="col">Due</th></tr>
        </thead>
        <tbody>
          {c.prototypes.map(({ id, topic, due }) => (
            <tr>
              <th scope="row">{prototypeHrefs[id] ? <a href={prototypeHrefs[id]}>{id}</a> : id}</th>
              <td>{topic}</td>
              <td>{fmtDay(due)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>Release</h3>
    {
      course === '250' ? (
        <p>
          Expand the Saturday Morning Archive, or build a small site for a real or realistic audience.
        </p>
      ) : (
        <p>
          An Astro site with Svelte islands, PokéAPI data, your <code>NOTES.md</code> files as a collection, and tests. Or
          use your own API, by proposal. You’ll also write your project’s own <code>AGENTS.md</code> and one custom
          skill, and explain why.
        </p>
      )
    }
    <ul>
      <li>Brief out <strong>{fmtDay(r.released)}</strong>; intent brief in class <strong>{fmtDay(r.intentBrief)}</strong>.</li>
      <li>
        Due <strong>{fmtDay(r.due)}, {r.dueTime}</strong>, the day of the open lab (the final-exam slot), which is for final
        help.
      </li>
      <li>
        {release ? <a href={pageHref(release)}>Read the Release brief</a> : <>The brief goes up on {fmtDay(r.released)}.</>}
      </li>
    </ul>
  </section>

  <section aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    <ul class="links" role="list">
      {
        skillOrder.map((name) => {
          const s = skillInfo(name, course);
          return (
            <li>
              <a href={skillHref(name, course)}>{s.title}</a>
              <code>{s.command}</code>
              <span>{s.description}</span>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-labelledby="reference">
    <h2 id="reference">Reference</h2>
    <ul class="links" role="list">
      <li><a href="/how-it-works/">How this course works</a><span>The loop, the assignments, grading, and the AI policy.</span></li>
      <li><a href="/notes/">The NOTES.md template</a><span>What goes in each section, and why it’s yours to write.</span></li>
      <li><a href="/agents/">AGENTS.md, explained</a><span>What the rules file in your repo tells the agent.</span></li>
    </ul>
  </section>
</Base>

<style>
  .lede {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 1.2rem;
  }

  section {
    margin-block-start: 2.5rem;
  }

  /* The row under the title: where the lists live. */
  .find {
    margin-block-start: 1.5rem;
  }

  .find h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .find ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .find li {
    margin: 0;
    font-weight: 700;
  }

  .find a {
    display: inline-block;
    padding-block: 0.35rem;
  }

  .find .soon {
    font-weight: 400;
    color: var(--muted);
  }

  /* The setup guide: first, and the one thing to do. */
  .start {
    padding: 0.25rem 1.5rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 0.35rem solid var(--accent);
    border-radius: var(--radius);
  }

  .start h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .go {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .facts {
    margin: 0 0 1.25rem;
  }

  .facts div {
    margin-block-end: 0.75rem;
  }

  .facts dt {
    font-weight: 700;
  }

  .facts dd {
    margin: 0;
  }

  .note {
    color: var(--muted);
    font-size: 1rem;
  }

  .topics {
    padding-inline-start: 1.75rem;
  }

  .topics li {
    margin-block-end: 0.75rem;
  }

  .topic-name {
    font-weight: 700;
    margin-inline-end: 0.5rem;
  }

  .topic-proto,
  .topic-link {
    font-size: 0.9rem;
    margin-inline-end: 0.5rem;
  }

  .topic-proto {
    color: var(--muted);
  }

  .topic-summary {
    display: block;
  }

  .table-wrap {
    overflow-x: auto;
    margin-block-end: 1.25rem;
  }

  .table-wrap table {
    margin: 0;
  }

  .table-wrap:focus-visible {
    outline-offset: 2px;
  }

  .links {
    list-style: none;
    padding: 0;
  }

  .links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.6rem;
    margin: 0 0 1rem;
  }

  .links a {
    font-weight: 700;
  }

  .links span {
    flex-basis: 100%;
    color: var(--muted);
  }
</style>
