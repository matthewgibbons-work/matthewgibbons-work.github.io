---
// One page per skill per course: /250/skills/dig-deeper/, check/ (and /340/…).
// What it does and how to run it. The skill's text is there to read, collapsed, with no
// copy button: after Spark 1 the kit is in the repo, so students run the slash command.
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageMeta from '../../../components/PageMeta.astro';
import { courseOrder, type Course } from '../../../lib/courses';
import { skillInfo, skillOrder, skillFile, skillWhere, type SkillName } from '../../../lib/skills';

export function getStaticPaths() {
  return courseOrder.flatMap((course) => skillOrder.map((name) => ({ params: { course, name } })));
}

const course = Astro.params.course as Course;
const name = Astro.params.name as SkillName;
const info = skillInfo(name, course);
const entry = await getEntry('prompts', skillFile(name, course));
if (!entry) throw new Error(`Skill "${skillFile(name, course)}" is missing: run npm run sync`);
---

<Base title={`${info.title} skill · DIGHT ${course}`} description={info.description} course={course}>
  <PageMeta courses={[`dight${course}`]} />
  <h1>{info.title} <code>{info.command}</code></h1>
  <p class="lede">{info.description}</p>

  <h2>How to use it</h2>
  <p>{skillWhere[course]}</p>
  <ol>
    {info.howTo.map((step) => <li>{step}</li>)}
  </ol>

  <h2>What it tells the agent</h2>
  <details>
    <summary>See the skill’s instructions</summary>
    <pre>{entry.body}</pre>
  </details>

  <p><a href={`/${course}/skills/`}>All skills</a> · <a href={`/${course}/`}>Course home</a></p>
</Base>

<style>
  .lede {
    font-size: 1.2rem;
  }

  h1 code {
    font-size: 0.7em;
  }

  details pre {
    white-space: pre-wrap;
  }
</style>
