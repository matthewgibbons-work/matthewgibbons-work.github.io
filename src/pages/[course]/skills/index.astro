---
// /250/skills/ and /340/skills/: this course's skills, run as slash commands all term.
// (Oct 19: renamed from prompts. The Start prompt now lives only on Spark 0.)
import Base from '../../../layouts/Base.astro';
import PageMeta from '../../../components/PageMeta.astro';
import { courses, courseOrder, type Course } from '../../../lib/courses';
import { skillInfo, skillOrder, skillHref, skillWhere } from '../../../lib/skills';

export function getStaticPaths() {
  return courseOrder.map((course) => ({ params: { course } }));
}

const course = Astro.params.course as Course;
const c = courses[course];
const folder = course === '250' ? '.github/skills/' : '.claude/skills/';
---

<Base title={`Skills · ${c.name}`} description={`The ${c.name} skills: /dig-deeper and /check.`} course={course}>
  <PageMeta courses={[`dight${course}`]} />
  <h1>Skills</h1>
  <p>
    Skills are instructions saved in your repo, in <code>{folder}</code>. Type the slash command in the chat and the
    agent follows them. {skillWhere[course]}
  </p>

  <ul class="skill-list" role="list">
    {
      skillOrder.map((name) => {
        const info = skillInfo(name, course);
        return (
          <li>
            <h2>
              <a href={skillHref(name, course)}>{info.title}</a>
              <code>{info.command}</code>
            </h2>
            <p>{info.description}</p>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .skill-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .skill-list li {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .skill-list h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.5rem;
    padding: 0;
    border: 0;
    font-size: 1.2rem;
  }

  .skill-list h2 code {
    font-size: 1rem;
  }

  .skill-list p {
    margin: 0.5rem 0 0;
  }
</style>
