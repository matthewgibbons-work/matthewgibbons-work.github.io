---
// /<course>/sparks/: every Spark in session order, with its date and whether it's out yet (Oct 21).
// Only published pages link; the rest show "Coming …" (see src/lib/schedule.ts). This route
// is /<course>/sparks/ and the single pages are /<course>/sparks/<slug>/, so they don't clash.
import Base from '../../../layouts/Base.astro';
import ItemTable from '../../../components/ItemTable.astro';
import PageMeta from '../../../components/PageMeta.astro';
import { courses, courseOrder, type Course } from '../../../lib/courses';
import { sparkItems } from '../../../lib/schedule';

export function getStaticPaths() {
  return courseOrder.map((course) => ({ params: { course } }));
}

const course = Astro.params.course as Course;
const c = courses[course];
const items = await sparkItems(course);
---

<Base title={`Sparks · ${c.name}`} description={`Every Spark in ${c.name}, in order, with dates.`} course={course}>
  <PageMeta courses={[`dight${course}`]} />
  <h1>Sparks</h1>
  <p>One Spark each session, started in studio time and due before the next class.</p>
  <p>
    The <a href={`/${course}/schedule/`}>schedule</a> shows everything due each week.
  </p>
  <ItemTable {items} dateLabel="Date" titleLabel="Spark" label={`${c.name} Sparks`} />
</Base>
