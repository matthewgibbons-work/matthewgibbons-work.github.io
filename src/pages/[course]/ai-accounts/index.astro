---
// "Keep Copilot for the course" guide: /250/ai-accounts/ only (Nov 16; 250 students were hitting
// Copilot usage limits). Source: dight-refactor/course-site-content/ai-accounts.md, whose
// `courses:` line names 250 only, so sync writes one copy. It follows the publish rule: no page until
// it's `ready: true` and its `date` has come (npm run dev shows it as a draft).
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import MarkdownBody from '../../../components/MarkdownBody.astro';
import { isShown } from '../../../lib/published';
import { courseOrder, type Course } from '../../../lib/courses';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const found = courseOrder.map((course) => ({ course, entry: pages.find((e) => e.id === `ai-accounts-${course}`) }));
  return found.flatMap(({ course, entry }) => (entry && isShown(entry) ? [{ params: { course } }] : []));
}

const course = Astro.params.course as Course;
const entry = await getEntry('pages', `ai-accounts-${course}`);
if (!entry) throw new Error(`ai-accounts-${course}.md is missing: run npm run sync`);
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<Base title={title} description={description} course={course}>
  <MarkdownBody>
    <Content />
  </MarkdownBody>
</Base>
