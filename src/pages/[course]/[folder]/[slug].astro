---
// Unit pages, Spark briefs, and Prototype briefs (Oct 19):
//   /<course>/units/<slug>/  /<course>/sparks/sNN/  /<course>/prototypes/pN/
// Sources: dight-refactor/course-site-content/<folder>/<course>-<slug>.md, copied by npm run sync.
// Production builds only make pages that are published (ready, and their date has come);
// dev makes every page. See src/lib/published.ts. The Release brief has its own route,
// /<course>/release/ (release/index.astro), because a course has just one.
import PageView from '../../../components/PageView.astro';
import { parseId, shownPages, type Kind, type Page } from '../../../lib/published';
import type { Course } from '../../../lib/courses';

export async function getStaticPaths() {
  const kinds: Kind[] = ['unit', 'spark', 'prototype'];
  const folders: Partial<Record<Kind, string>> = { unit: 'units', spark: 'sparks', prototype: 'prototypes' };
  const pages = (await Promise.all(kinds.map((kind) => shownPages(kind)))).flat();
  return pages.map((page) => {
    const { kind, course, slug } = parseId(page.id)!;
    return { params: { course, folder: folders[kind], slug }, props: { page } };
  });
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const course = Astro.params.course as Course;
---

<PageView {page} {course} />
