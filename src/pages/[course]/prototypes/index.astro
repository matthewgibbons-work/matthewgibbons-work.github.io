---
// /<course>/prototypes/: every Prototype in session order, with its date and whether it's out yet (Oct 21).
// Only published pages link; the rest show "Coming …" (see src/lib/schedule.ts). This route
// is /<course>/prototypes/ and the single pages are /<course>/prototypes/<slug>/, so they don't clash.
import Base from '../../../layouts/Base.astro';
import ItemTable from '../../../components/ItemTable.astro';
import PageMeta from '../../../components/PageMeta.astro';
import { courses, courseOrder, type Course } from '../../../lib/courses';
import { prototypeItems } from '../../../lib/schedule';

export function getStaticPaths() {
  return courseOrder.map((course) => ({ params: { course } }));
}

const course = Astro.params.course as Course;
const c = courses[course];
const items = await prototypeItems(course);
---

<Base title={`Prototypes · ${c.name}`} description={`Every Prototype in ${c.name}, in order, with dates.`} course={course}>
  <PageMeta courses={[`dight${course}`]} />
  <h1>Prototypes</h1>
  <p>One Prototype a week from Oct 26, four in all. Each combines that week’s units into one piece.</p>
  <p>
    The <a href={`/${course}/schedule/`}>schedule</a> shows everything due each week.
  </p>
  <ItemTable {items} dateLabel="Out" titleLabel="Prototype" label={`${c.name} Prototypes`} />
</Base>
