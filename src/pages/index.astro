---
// Home: a hub that never needs updating (site v2, Oct 17). One question, which course,
// as two big cards; then a quiet row of term-long links. No dates, no "today".
import Base from '../layouts/Base.astro';
import CourseCards from '../components/CourseCards.astro';

const reference = [
  { href: '/how-it-works/', title: 'How this course works', text: 'The loop, the assignments, grading, and the AI policy.' },
  { href: '/notes/', title: 'The NOTES.md template', text: 'What goes in each section, and why it’s yours to write.' },
  { href: '/agents/', title: 'AGENTS.md, explained', text: 'What the rules file in your repo tells the agent.' },
];
---

<Base
  title="DIGHT 250 & 340"
  description="Course site for DIGHT 250 (HTML and CSS) and DIGHT 340 (JavaScript, Svelte, and Astro)."
>
  <h1>DIGHT 250 &amp; 340</h1>
  <p class="lede">
    Both courses work a new way this term. An AI agent writes most of the syntax. You decide what to build, check
    what it wrote, and explain every choice.
  </p>

  <h2>Pick your course</h2>
  <CourseCards />

  <h2 class="reference-heading">For both courses</h2>
  <ul class="reference" role="list">
    {
      reference.map((r) => (
        <li>
          <a href={r.href}>{r.title}</a>
          <span>{r.text}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .lede {
    font-size: 1.2rem;
  }

  /* The reference row: quieter than the cards, so the course choice comes first. */
  .reference-heading {
    margin-block-start: 3rem;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .reference {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem 1.5rem;
  }

  .reference li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0;
  }

  .reference a {
    font-weight: 700;
  }

  .reference span {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
