const toc = [
  { id: 'why', label: 'Why we’re changing' },
  { id: 'loop', label: 'The loop' },
  { id: 'assignments', label: 'Sparks, Prototypes, and the Release' },
  { id: 'grading', label: 'How it’s graded' },
