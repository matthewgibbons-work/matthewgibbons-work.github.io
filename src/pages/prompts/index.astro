---
// /prompts/: lists the four copy-paste prompts.
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { prompts, promptOrder } from '../../lib/prompts';
---

<Base title="Prompts" description="The Start prompts for Spark 0, and the copy-paste versions of /dig-deeper and /check.">
  <h1>Prompts</h1>
  <p>
    Copying a prompt from here and pasting it into the chat always works. The Start prompts run Spark 0 once, so
    you always paste them. Dig deeper and Check are also slash commands: once the starter kit is in your repo,
    <code>/dig-deeper</code> and <code>/check</code> run the same text.
  </p>

  <ul class="prompt-list" role="list">
    {
      promptOrder.map((name) => {
        const info = prompts[name];
        return (
          <li>
            <h2>
              <a href={`/prompts/${name}/`}>{info.title}</a>
            </h2>
            <p class="badges">
              {info.courses.map((c) => (
                <Badge kind={c === 'dight250' ? '250' : '340'} />
              ))}
              {info.command && <code>{info.command}</code>}
            </p>
            <p>{info.description}</p>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .prompt-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .prompt-list li {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .prompt-list h2 {
    margin: 0 0 0.5rem;
    padding: 0;
    border: 0;
    font-size: 1.2rem;
  }

  .prompt-list p {
    margin: 0.5rem 0 0;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
</style>
