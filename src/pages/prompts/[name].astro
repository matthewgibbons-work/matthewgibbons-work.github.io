---
// /prompts/dig-deeper/ and /prompts/check/ ask which course. The shared pages
// (How it works, NOTES, AGENTS) link here, so they never need a course.
// The old /prompts/start-250 and start-340 redirect in astro.config.mjs instead.
import WhichCourse from '../../components/WhichCourse.astro';

export function getStaticPaths() {
  return [
    { params: { name: 'dig-deeper' }, props: { thing: 'the Dig deeper prompt' } },
    { params: { name: 'check' }, props: { thing: 'the Check prompt' } },
  ];
}

const { name } = Astro.params;
const { thing } = Astro.props;
---

<WhichCourse thing={thing} to={`prompts/${name}/`} />
