---
// A Copy button for a text block elsewhere on the page.
// Styles (.copy-bar, .copy-button, .copy-status) are in global.css and the script is
// src/lib/copy.ts, because MarkdownBody builds the same bar as an HTML string (Nov 3).
interface Props {
  target: string;
  label?: string;
  /** What the status line says after a successful copy. */
  copied?: string;
}

const { target, label = 'Copy prompt', copied = 'Copied. Paste it into the chat.' } = Astro.props;
---

<div class="copy-bar">
  <button type="button" class="copy-button" data-copy-target={target} data-copied={copied} hidden>{label}</button>
  <p class="copy-status" role="status"></p>
</div>

<script>
  import '../lib/copy';
</script>
