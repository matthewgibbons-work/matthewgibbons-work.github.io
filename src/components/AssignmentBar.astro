---
// The sticky assignment bar (experiment 6, session 7, Nov 4): a slim bar pinned to the foot
// of the viewport on a unit page, linking its Spark (with due date) and the Prototype it
// feeds, so students can jump to the task without scrolling to the "This session" panel.
// Opt-in per unit with `sticky_assignments: true`, so the experiment stays on the pages it
// was tried on (PLAN.md, Open items, "Experiments").
//
// CSS only (the JS budget stays at the copy button and the theme toggle): `position: sticky`
// at the end of <main>, so it rides the viewport's foot while reading and settles in place
// at the end of the page instead of covering the footer. Short viewports (200% zoom, a
// landscape phone) get it in the flow instead, so it never eats the screen.
// Published pages only, as everywhere; with nothing to link, it isn't rendered.
import { pageHref, prototypePage, sessionPair, type Page } from '../lib/published';
import type { Course } from '../lib/courses';

interface Props {
  page: Page;
  course: Course;
}

const { page, course } = Astro.props;
const { session, prototype } = page.data;

const spark = session ? (await sessionPair(course, session)).spark : undefined;
const brief = prototype ? await prototypePage(course, prototype) : undefined;

const links = [
  { page: spark, kind: 'Spark' },
  { page: brief, kind: 'Prototype' },
]
  .filter((l): l is { page: Page; kind: string } => l.page !== undefined)
  .map(({ page: p, kind }) => ({
    href: pageHref(p),
    // "S07 · Grid layout" → "Spark S07": the bar has room for the code only; the full title
    // is in the meta line and the "This session" panel.
    kind,
    code: p.data.title.split(' · ')[0],
    title: p.data.title,
    due: p.data.due,
  }));

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

{
  links.length > 0 && (
    <nav class="assignment-bar" aria-label="Assignments for this unit">
      <ul>
        {links.map(({ href, kind, code, title, due }) => (
          <li>
            {/* One line: compressHTML is off, so line breaks here would show as spaces. */}
            <a href={href} title={title}><span class="word">{kind} </span>{code}<span aria-hidden="true"> →</span></a>{due && <span class="due"><span class="word">due </span><time datetime={iso(due)}>{fmt(due)}</time></span>}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .assignment-bar {
    position: sticky;
    inset-block-end: 0;
    z-index: 10;
    margin-block-start: 3rem;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 0.25rem solid var(--yellow);
    border-radius: var(--radius) var(--radius) 0 0;
    box-shadow: 0 -0.5rem 1.5rem rgb(0 0 0 / 0.25);
  }

  .assignment-bar ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .assignment-bar li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* 44px tall targets, like the header nav. */
  .assignment-bar a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-weight: 700;
  }

  .assignment-bar .due {
    color: var(--muted);
  }

  /* Phones: one row, not two. "Spark", "Prototype", and "due" stay for screen readers;
     "S07 → Nov 16" reads fine on its own, since the codes are used everywhere. */
  @media (max-width: 30rem) {
    .assignment-bar {
      padding-inline: 0.75rem;
    }

    .assignment-bar ul {
      column-gap: 1rem;
    }

    .assignment-bar li {
      gap: 0.35rem;
    }

    .word {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Keep it out of the way where screen height is scarce: in the flow, not pinned. */
  @media (max-height: 30rem) {
    .assignment-bar {
      position: static;
    }
  }

  @media print {
    .assignment-bar {
      display: none;
    }
  }

  /* Keyboard focus and in-page links shouldn't land behind the bar (WCAG 2.4.11). */
  :global(html:has(.assignment-bar)) {
    scroll-padding-block-end: 5rem;
  }
</style>
