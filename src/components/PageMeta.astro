---
// The strip above a page's h1: course and tier badges, then the dates, and on briefs the
// repo folder and the unit(s) it belongs to (Oct 19: briefs keep these out of their body).
// On a unit page, its Spark and due date (Oct 28).
import Badge from './Badge.astro';

interface Props {
  /** 'dight250', 'dight340', …: the frontmatter's `courses`. */
  courses: string[];
  tier?: 'spark' | 'prototype' | 'release';
  /** The session a unit page or Spark belongs to. */
  date?: Date;
  /** When a Prototype brief goes out. */
  released?: Date;
  due?: Date;
  /** The student's repo folder for this assignment. */
  folder?: string;
  /** A Spark's unit, or a Prototype's units; published pages only. */
  units?: { href: string; title: string }[];
  /** A unit page's Spark; published pages only. */
  spark?: { href: string; title: string; due?: Date };
}

const { courses, tier, date, released, due, folder, units = [], spark } = Astro.props;

// Frontmatter dates are midnight UTC; format in UTC so they don't slip a day.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<div class="page-meta">
  <p class="badges">
    {courses.map((c) => <Badge kind={c.replace(/^dight/, '')} />)}
    {tier && <Badge kind={tier} />}
  </p>
  {
    (date || released || due) && (
      <p class="dates">
        {date && (
          <span>
            Session: <time datetime={iso(date)}>{fmt(date)}</time>
          </span>
        )}
        {released && (
          <span>
            Released: <time datetime={iso(released)}>{fmt(released)}</time>
          </span>
        )}
        {due && (
          <span>
            Due: <time datetime={iso(due)}>{fmt(due)}</time>
          </span>
        )}
      </p>
    )
  }
  {
    spark && (
      <p class="dates">
        <span>
          {/* One line, for the same reason as the units list below. */}
          Spark: <a href={spark.href}>{spark.title}</a>{spark.due && <> · due <time datetime={iso(spark.due)}>{fmt(spark.due)}</time></>}
        </span>
      </p>
    )
  }
  {
    (folder || units.length > 0) && (
      <p class="dates">
        {folder && (
          <span>
            Folder: <code>{folder}</code>
          </span>
        )}
        {units.length > 0 && (
          <span>
            {units.length === 1 ? 'Unit' : 'Units'}:{' '}
            {/* One line: compressHTML is off, so line breaks here would show as a space before each comma. */}
            {units.map((unit, i) => <>{i > 0 && ', '}<a href={unit.href}>{unit.title}</a></>)}
          </span>
        )}
      </p>
    )
  }
</div>

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block-end: 1rem;
  }

  .page-meta p {
    margin: 0;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
