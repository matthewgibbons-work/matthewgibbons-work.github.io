  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} · Berry guide</title>
</head>
<body>
  <nav aria-label="Site">
    <ul>
      <li><a href={url()}>Home</a></li>
      <li><a href={url('berries/')}>Berries</a></li>
    </ul>
  </nav>
  <main>
    <slot />
  </main>
